# Imagen PayRam (propietaria; se descarga del registry, no se redistribuye)
PAYRAM_IMAGE=payramapp/payram@sha256:1181cd5d886a50d68565c275dad231d9a1d75735dca3ce5873f334c2f9db3791
PAYRAM_APPROVED_DIGEST=sha256:1181cd5d886a50d68565c275dad231d9a1d75735dca3ce5873f334c2f9db3791
POSTGRES_IMAGE=postgres:16-alpine@sha256:721873c34ceb9f8d8fc265984940dc982404c105f19ad51be9fdc5970a6080ea
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

# Dominio y TLS
PAYRAM_DOMAIN=pay.example.com
ACME_EMAIL=admin@example.com

# Red / base de datos
PAYRAM_NETWORK_TYPE=mainnet
PAYRAM_SERVER=PRODUCTION
POSTGRES_DB=payram
POSTGRES_USER=payram
POSTGRES_PASSWORD=change-me-strong-postgres-password
INTERNAL_POSTGRES_PASSWORD=change-me-strong-internal-postgres-password
AES_KEY=change-me-generate-a-random-64-hex

# Hardening de payouts (semilla de configuración)
PAYRAM_AUTO_APPROVE=false
PAYRAM_AUTO_APPROVE_USD=0
PAYRAM_OTP_THRESHOLD_USD=0
PAYRAM_DAILY_LIMIT_USD=1000
PAYRAM_HOURLY_LIMIT_USD=500
PAYRAM_PATCH_FRONTEND=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
METAMASK_ANALYTICS_ENDPOINT=

# El overlay mitiga configuración/red, NO los CVEs del código Next/Go.
# Debe ser una aceptación explícita y consciente; no es un parche completo.
PAYRAM_HARDENING_ENABLED=true
ALLOW_KNOWN_VULNERABLE_PAYRAM=true
